########## Assets (selective exclusions) ##########
# Ignore certain large, topic-specific image folders not used in current build.
assets/images/*/archive/*
assets/images/genai/*/archive/*

########## Model Weights / Checkpoints ##########
*.pt
*.pth
*.ckpt
*.onnx
# The browser demo needs its exported model on GitHub Pages
!demos/cnns/augmentation_stability/model/*.onnx
*.h5
checkpoints/
models/

########## Logs & Temp ##########
logs/
*.log
*.out
*.err
*.tmp
*.temp

########## Misc Generated ##########
*.bak
*.swp
*.swo
*.orig
*.rej

########## Explicitly Keep ##########
!AGENTS.md
!TODO.md

########## Claude Code ##########
.claude/

########## Exam ##########
exam/*


#############################################
# Notes:
# - Removed previous broad 'demos/*' ignore so that demo notebooks remain tracked.
# - Added negative patterns for AGENTS.md and TODO.md to ensure inclusion.
# - If you later add curated sample data, place a README.md inside a subfolder and
#   negate its path similarly to keep documentation but ignore bulk binaries.
# - Adjust data/ & model weight patterns if versioning small models intentionally.
#############################################

